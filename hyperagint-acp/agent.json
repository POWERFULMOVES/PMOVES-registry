{
  "id": "hyperagint-acp",
  "name": "HyPeRAGInT ACP",
  "version": "0.21.4",
  "description": "HyPeRAGInT edition of PMOVES Hermes Agent (MoA harness) as an ACP stdio coding agent: registry-driven identity, per-node model suits, and fleet routing",
  "repository": "https://github.com/POWERFULMOVES/PMOVES-hermes-agent",
  "website": "https://github.com/POWERFULMOVES/PMOVES-hermes-agent#readme",
  "authors": [
    "POWERFULMOVES"
  ],
  "license": "MIT",
  "license_url": "https://github.com/POWERFULMOVES/PMOVES-hermes-agent/blob/main/LICENSE",
  "distribution": {
    "binary": {
      "windows-x86_64": {
        "archive": "https://github.com/POWERFULMOVES/PMOVES-hermes-agent/releases/download/v0.21.4/hyperagint-acp-windows-x86_64.zip",
        "cmd": "hyperagint-acp.exe"
      }
    }
  },
  "x-pmoves": {
    "layer": "identity",
    "edition": "HyPeRAGInT",
    "harness": {
      "kind": "pmoves-hermes-elder-melchor MoA",
      "upstream": "https://github.com/POWERFULMOVES/PMOVES-hermes-agent",
      "version_source": "hermes_cli.__version__ (PMOVES-hermes-agent main)",
      "moa_preset": "EMHERMES",
      "moa_models": {
        "aggregator": "zai:glm-5.3-flash",
        "reference": "zai:glm-5.3-flash"
      }
    },
    "provenance": {
      "registry_commit": "4b05abb",
      "branch_point": "a5cc072",
      "branch": "feat/hyperagint-registry-entry",
      "task": "t_0a9c4bcb",
      "authored": "2026-09-27",
      "chit": "PR carries CHIT provenance; every dispatched call names registry commit 4b05abb"
    },
    "nodes": [
      {
        "node": "elder",
        "mode": "cloud-first",
        "suit": "suit-elder"
      },
      {
        "node": "z890",
        "mode": "local-hermes3",
        "suit": "suit-z890"
      },
      {
        "node": "5090",
        "mode": "local-hermes3",
        "suit": "suit-5090"
      },
      {
        "node": "spark",
        "mode": "local-hermes3",
        "suit": "suit-spark"
      }
    ],
    "suit_source": "suit manifests embedded verbatim from the env layer (kanban t_57100539, commit a3f9c9c - content owner) by the routing layer (t_f0e9adf4); env/ files remain the authoring source of truth, this embed is the runtime copy",
    "routing": "dispatch resolves node -> suit + tailnet serve URL from this entry at runtime (kanban t_f0e9adf4); no hardcoded node tables in harness code",
    "artifact": {
      "status": "pending-release",
      "note": "windows-x86_64 zip lands with PMOVES-hermes-agent v0.21.4; the archive URL above is canonical once published"
    },
    "env_shared": {
      "file": "env/env.shared",
      "vars": {
        "HYPERAGINT_HARNESS": "hyperagint-acp",
        "HYPERAGINT_MOA_PRESET": "EMHERMES",
        "HYPERAGINT_MOA_AGGREGATOR_PROVIDER": "zai",
        "HYPERAGINT_MOA_AGGREGATOR_MODEL": "glm-5.3-flash",
        "HYPERAGINT_MOA_REFERENCE_PROVIDER": "zai",
