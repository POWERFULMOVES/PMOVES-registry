        "HYPERAGINT_MOA_REFERENCE_COUNT": "1",
        "HYPERAGINT_MOA_DEGRADED_REFERENCE_POLICY": "loud",
        "HYPERAGINT_MOA_FANOUT": "per_iteration",
        "HYPERAGINT_MOA_MAX_TOKENS": "4096",
        "HYPERAGINT_REGISTRY_GROUNDING_COMMIT": "4b05abb"
      }
    },
    "suits": {
