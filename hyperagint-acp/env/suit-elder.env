# HyPeRAGInT model suit — ELDER (cloud-first, seed-preset exact)
# Node: Elder-Melchor laptop, GTX 1650 4GB — no local LLM serving.
# Hermes profile: pmoves-hermes-elder. First target node (build/verify loop).
# Load order: source env.shared FIRST, then THIS file (overlay wins).
# Encoding: UTF-8 no BOM, LF. Plain values only — no ${VAR} literals.
#
# Delta vs EMHERMES base: NONE. This suit restates the preset explicitly so the
# file stands alone without diffing against env.shared (reproducibility doctrine).

HYPERAGINT_NODE=elder
HYPERAGINT_EXECUTION_MODE=cloud
HYPERAGINT_MOA_PRESET=EMHERMES
HYPERAGINT_MOA_AGGREGATOR_PROVIDER=zai
HYPERAGINT_MOA_AGGREGATOR_MODEL=glm-5.3-flash
HYPERAGINT_MOA_REFERENCE_PROVIDER=zai
HYPERAGINT_MOA_REFERENCE_MODEL=glm-5.3-flash
HYPERAGINT_MOA_REFERENCE_COUNT=1
HYPERAGINT_MOA_DEGRADED_REFERENCE_POLICY=loud
HYPERAGINT_MOA_FANOUT=per_iteration
HYPERAGINT_MOA_MAX_TOKENS=4096

# No OLLAMA_HOST: elder runs no local inference server.
# Secret: ZAI_API_KEY via secret funnel (pmoves/env.tier-*) — name only, never a value.
