# HyPeRAGInT model suit — 5090 (local-first, primary GPU)
# Node: 5090 workstation, RTX 5090 32GB. Hermes profile: pmoves-hermes-5090.
# Load order: source env.shared FIRST, then THIS file (overlay wins).
# Encoding: UTF-8 no BOM, LF. Plain values only — no ${VAR} literals.
#
# Delta vs EMHERMES base: aggregator/reference move from zai glm-5.3-flash
# (cloud) to local Ollama hermes3:8b. Topology (1 reference, loud,
# per_iteration, max_tokens 4096) is inherited unchanged from env.shared.

HYPERAGINT_NODE=5090
HYPERAGINT_EXECUTION_MODE=local
HYPERAGINT_MOA_PRESET=EMHERMES
HYPERAGINT_MOA_AGGREGATOR_PROVIDER=ollama
HYPERAGINT_MOA_AGGREGATOR_MODEL=hermes3:8b
HYPERAGINT_MOA_REFERENCE_PROVIDER=ollama
HYPERAGINT_MOA_REFERENCE_MODEL=hermes3:8b
HYPERAGINT_MOA_REFERENCE_COUNT=1
HYPERAGINT_MOA_DEGRADED_REFERENCE_POLICY=loud
HYPERAGINT_MOA_FANOUT=per_iteration
HYPERAGINT_MOA_MAX_TOKENS=4096

# Local serving: node Hermes profile consumes local Ollama (11434).
# Stand-up: `ollama serve` (11434) + `ollama pull hermes3:8b` before harness launch.
# 7700 is the Hermes gateway port — unrelated to this suit.
OLLAMA_HOST=127.0.0.1:11434

# Fallback (documented in PMOVES.AI HERMES.md fleet table): zai-coding cloud
# path, same as the elder suit. Secret name only — ZAI_API_KEY via secret funnel.
