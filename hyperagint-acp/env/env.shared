# HyPeRAGInT env layer — SHARED BASE (env.shared)
# Load order: source this file FIRST, then exactly one suit-<node>.env overlay.
# Derived from the EMHERMES MoA preset (Hermes profile pmoves-hermes-elder,
# config.yaml moa.presets.EMHERMES). Grounded on POWERFULMOVES/PMOVES-registry
# @ 4b05abb (main). Task: t_57100539.
#
# Encoding contract: UTF-8 without BOM, LF line endings. Values are plain
# strings — no ${VAR} expansion literals anywhere in this layer.

# --- Harness / suit selection (registry-driven dispatch join key) ---
HYPERAGINT_HARNESS=hyperagint-acp
# HYPERAGINT_NODE is set by each suit file: z890 | 5090 | spark | elder

# --- EMHERMES MoA topology (base = seed preset; local suits override model pins) ---
HYPERAGINT_MOA_PRESET=EMHERMES
HYPERAGINT_MOA_AGGREGATOR_PROVIDER=zai
HYPERAGINT_MOA_AGGREGATOR_MODEL=glm-5.3-flash
HYPERAGINT_MOA_REFERENCE_PROVIDER=zai
HYPERAGINT_MOA_REFERENCE_MODEL=glm-5.3-flash
HYPERAGINT_MOA_REFERENCE_COUNT=1
HYPERAGINT_MOA_DEGRADED_REFERENCE_POLICY=loud
HYPERAGINT_MOA_FANOUT=per_iteration
# 4096 is inherited from the top-level moa: scope in the source config —
# not preset-specific, but pinned here so every variant reproduces it.
HYPERAGINT_MOA_MAX_TOKENS=4096

# --- Registry provenance ---
# Commit this env layer was AUTHORED against. At runtime the routing layer must
# stamp the LIVE resolved registry commit into HYPERAGINT_REGISTRY_COMMIT —
# grounding commit is authoring metadata, not a runtime pin.
HYPERAGINT_REGISTRY_GROUNDING_COMMIT=4b05abb

# --- Secrets: names only, never values (env-indirection doctrine) ---
# ZAI_API_KEY resolves per node via the secret funnel (pmoves/env.tier-*).
# Never inline secret values in this file or any suit file.
