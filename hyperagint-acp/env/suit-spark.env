# HyPeRAGInT model suit — SPARK (local-first, large-memory)
# Node: DGX Spark (GB10, 128GB unified memory). Hermes profile: pmoves-hermes-spark.
# Load order: source env.shared FIRST, then THIS file (overlay wins).
# Encoding: UTF-8 no BOM, LF. Plain values only — no ${VAR} literals.
#
# Delta vs EMHERMES base: aggregator/reference move from zai glm-5.3-flash
# (cloud) to local Ollama hermes3:70b (fits GB10 unified memory). Topology
# (1 reference, loud, per_iteration, max_tokens 4096) inherited from env.shared.

HYPERAGINT_NODE=spark
HYPERAGINT_EXECUTION_MODE=local
HYPERAGINT_MOA_PRESET=EMHERMES
HYPERAGINT_MOA_AGGREGATOR_PROVIDER=ollama
HYPERAGINT_MOA_AGGREGATOR_MODEL=hermes3:70b
HYPERAGINT_MOA_REFERENCE_PROVIDER=ollama
HYPERAGINT_MOA_REFERENCE_MODEL=hermes3:70b
HYPERAGINT_MOA_REFERENCE_COUNT=1
HYPERAGINT_MOA_DEGRADED_REFERENCE_POLICY=loud
HYPERAGINT_MOA_FANOUT=per_iteration
HYPERAGINT_MOA_MAX_TOKENS=4096

# Local serving: node Hermes profile consumes local Ollama (11434).
# Stand-up: `ollama serve` (11434) + `ollama pull hermes3:70b` before harness launch.
# 7700 is the Hermes gateway port — unrelated to this suit.
OLLAMA_HOST=127.0.0.1:11434

# No zai-coding fallback is documented for this profile in HERMES.md — the
# spark variant is local-only. Fleet offload target for 70B-class work.
